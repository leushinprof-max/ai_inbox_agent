{
  "name": "ai-inbox-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 43600",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 43600",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/integration/*.test.mts",
    "seed:local": "tsx tools/seed-local.mts",
    "worker": "node --conditions=react-server --import tsx tools/worker.mts",
    "worker:local": "node --env-file=.env.local --conditions=react-server --import tsx tools/worker.mts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.115.0",
    "exceljs": "4.4.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tsx": "4.23.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
