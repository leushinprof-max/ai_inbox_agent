NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key stable and backed up; changing it makes existing connections unreadable.
INBOX_ENCRYPTION_KEY=
INBOX_APP_URL=http://127.0.0.1:43600
OPENAI_API_KEY=
# Fallback for Product admin model settings set to Server default (and older versions).
# Explicit published classification/reply models take precedence. Keep web/worker aligned.
INBOX_MODEL=gpt-4.1-mini-2025-04-14
# Worker HTTP port; the web process uses its own hosting configuration.
PORT=43601
